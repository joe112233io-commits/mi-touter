{
  "name": "tutorai-desktop",
  "version": "1.0.0",
  "description": "TutorAI Desktop Platform - AI-Powered Generative Learning Management System with Local Realm DB and Electron Support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx esbuild js/firebase-client.ts --bundle --outfile=js/firebase-bundle.js --format=iife --target=es2020 && node server.js",
    "build": "npx esbuild js/firebase-client.ts --bundle --outfile=js/firebase-bundle.js --format=iife --target=es2020",
    "lint": "npx eslint firestore.rules",
    "serve": "node server.js"
  },
  "keywords": [
    "tutorai",
    "ai-learning",
    "electron",
    "realm-db",
    "spaced-repetition",
    "math-solver",
    "homeworkify"
  ],
  "author": "Lumination AI / Azvai Engineering Replica",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0"
  },
  "build": {
    "appId": "com.azvai.tutorai",
    "productName": "TutorAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "css/**/*",
      "database/**/*",
      "js/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
