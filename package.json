{
  "name": "tutorai-desktop",
  "version": "1.0.0",
  "description": "TutorAI Desktop Platform - AI-Powered Generative Learning Management System with Local Realm DB and Electron Support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "serve": "npx serve -l 3000 .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "tutorai",
    "ai-learning",
    "electron",
    "realm-db",
    "spaced-repetition",
    "math-solver",
    "homeworkify"
  ],
  "author": "Lumination AI / Azvai Engineering Replica",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.azvai.tutorai",
    "productName": "TutorAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "css/**/*",
      "database/**/*",
      "js/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
