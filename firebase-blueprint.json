{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner profile, subscription tier, and study preferences (non-PII).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The authenticated Firebase Auth UID owning this profile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Display name of the learner.",
          "minLength": 1,
          "maxLength": 120
        },
        "planTier": {
          "type": "string",
          "description": "Subscription plan tier.",
          "enum": ["free", "mentor", "genius", "enterprise"],
          "minLength": 4,
          "maxLength": 20
        },
        "coursesGeneratedCount": {
          "type": "integer",
          "description": "Total number of bespoke courses generated by this user."
        },
        "knowledgeLevelPref": {
          "type": "string",
          "description": "Preferred difficulty level.",
          "enum": ["beginner", "intermediate", "advanced", "all"],
          "minLength": 3,
          "maxLength": 32
        },
        "learningStylePref": {
          "type": "string",
          "description": "Preferred pedagogical style.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "userId",
        "fullName",
        "planTier",
        "coursesGeneratedCount",
        "knowledgeLevelPref",
        "learningStylePref",
        "createdAt",
        "updatedAt"
      ]
    },
    "AIProviderMetadata": {
      "title": "AIProviderMetadata",
      "description": "Non-secret AI provider configuration metadata owned by a learner (raw API keys are never stored in Firestore).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this AI provider configuration.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "User-facing display name of the AI provider.",
          "minLength": 1,
          "maxLength": 80
        },
        "providerType": {
          "type": "string",
          "description": "Provider identifier (openrouter, gemini, openai, anthropic, groq, deepseek, custom).",
          "minLength": 2,
          "maxLength": 40
        },
        "protocol": {
          "type": "string",
          "description": "API protocol family.",
          "enum": ["openai-compatible", "gemini-native", "gemini-server", "anthropic-messages", "custom-rest"],
          "minLength": 5,
          "maxLength": 40
        },
        "baseUrl": {
          "type": "string",
          "description": "Base URL of the API endpoint.",
          "minLength": 0,
          "maxLength": 300
        },
        "modelId": {
          "type": "string",
          "description": "Target LLM model identifier.",
          "minLength": 1,
          "maxLength": 120
        },
        "maskedKey": {
          "type": "string",
          "description": "Masked preview of the API key (never the raw secret).",
          "minLength": 1,
          "maxLength": 40
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this provider is the default for course generation."
        },
        "lastTestedStatus": {
          "type": "string",
          "description": "Result of the most recent live connection test.",
          "enum": ["untested", "verified", "failed"],
          "minLength": 6,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "name",
        "providerType",
        "protocol",
        "baseUrl",
        "modelId",
        "maskedKey",
        "isDefault",
        "lastTestedStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "Course": {
      "title": "Course",
      "description": "A bespoke AI-generated or curated learning course owned by a learner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this course.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Course title.",
          "minLength": 1,
          "maxLength": 200
        },
        "topicPrompt": {
          "type": "string",
          "description": "Original prompt or topic used to generate the course.",
          "minLength": 1,
          "maxLength": 500
        },
        "learnerLevel": {
          "type": "string",
          "description": "Target learner level.",
          "enum": ["beginner", "intermediate", "advanced", "all"],
          "minLength": 3,
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "description": "Summary description of the course.",
          "minLength": 1,
          "maxLength": 2000
        },
        "progressPercentage": {
          "type": "number",
          "description": "Completion percentage from 0 to 100."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the course was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the course was last updated."
        }
      },
      "required": [
        "userId",
        "title",
        "topicPrompt",
        "learnerLevel",
        "description",
        "progressPercentage",
        "createdAt",
        "updatedAt"
      ]
    },
    "Module": {
      "title": "Module",
      "description": "A curriculum module belonging to a specific Course.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the course owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "description": "ID of the parent Course document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "integer",
          "description": "1-based display order of the module."
        },
        "title": {
          "type": "string",
          "description": "Module title.",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "description": "Module summary.",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "courseId",
        "orderIndex",
        "title",
        "summary",
        "createdAt",
        "updatedAt"
      ]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "An individual lesson within a Module and Course.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the course owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "description": "ID of the parent Course document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "moduleId": {
          "type": "string",
          "description": "ID of the parent Module document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "integer",
          "description": "1-based display order of the lesson."
        },
        "title": {
          "type": "string",
          "description": "Lesson title.",
          "minLength": 1,
          "maxLength": 200
        },
        "contentMarkdown": {
          "type": "string",
          "description": "Markdown body of the lesson.",
          "minLength": 0,
          "maxLength": 50000
        },
        "simplifiedMarkdown": {
          "type": "string",
          "description": "Simplified explanation markdown.",
          "minLength": 0,
          "maxLength": 25000
        },
        "examplesMarkdown": {
          "type": "string",
          "description": "Real-world examples markdown.",
          "minLength": 0,
          "maxLength": 25000
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Whether the learner has completed this lesson."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "courseId",
        "moduleId",
        "orderIndex",
        "title",
        "contentMarkdown",
        "simplifiedMarkdown",
        "examplesMarkdown",
        "isCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "SM-2 spaced repetition flashcard belonging to a learner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the card owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "description": "ID of the associated Course.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lessonId": {
          "type": "string",
          "description": "ID of the associated Lesson.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "frontPrompt": {
          "type": "string",
          "description": "Question or term on the front of the card.",
          "minLength": 1,
          "maxLength": 1000
        },
        "backAnswer": {
          "type": "string",
          "description": "Answer or definition on the back of the card.",
          "minLength": 1,
          "maxLength": 2000
        },
        "easinessFactor": {
          "type": "number",
          "description": "SM-2 easiness factor (>= 1.3)."
        },
        "intervalDays": {
          "type": "integer",
          "description": "Current review interval in days."
        },
        "repetitions": {
          "type": "integer",
          "description": "Consecutive successful recall repetitions."
        },
        "nextReviewAtIso": {
          "type": "string",
          "description": "ISO date string for the next scheduled review.",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "courseId",
        "lessonId",
        "frontPrompt",
        "backAnswer",
        "easinessFactor",
        "intervalDays",
        "repetitions",
        "nextReviewAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "HomeworkSolution": {
      "title": "HomeworkSolution",
      "description": "Step-by-step math or homework solution saved by a learner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the learner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toolType": {
          "type": "string",
          "description": "Solver tool type.",
          "enum": ["math_solver", "homeworkify"],
          "minLength": 5,
          "maxLength": 32
        },
        "inputText": {
          "type": "string",
          "description": "Problem statement or equation.",
          "minLength": 1,
          "maxLength": 2000
        },
        "extractedLatex": {
          "type": "string",
          "description": "Normalized LaTeX representation.",
          "minLength": 0,
          "maxLength": 2000
        },
        "subjectCategory": {
          "type": "string",
          "description": "Academic subject classification.",
          "minLength": 1,
          "maxLength": 100
        },
        "finalAnswer": {
          "type": "string",
          "description": "Verified final answer summary.",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when solved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "toolType",
        "inputText",
        "extractedLatex",
        "subjectCategory",
        "finalAnswer",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores learner profile and study preferences scoped strictly to the user."
    },
    "/aiProviders/{providerId}": {
      "schema": { "$ref": "#/entities/AIProviderMetadata" },
      "description": "Stores non-secret AI provider metadata and masked key previews scoped strictly by userId."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Stores learner courses scoped by userId."
    },
    "/modules/{moduleId}": {
      "schema": { "$ref": "#/entities/Module" },
      "description": "Stores course modules referencing parent /courses/{courseId}."
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Stores course lessons referencing parent /courses/{courseId} and /modules/{moduleId}."
    },
    "/flashcards/{flashcardId}": {
      "schema": { "$ref": "#/entities/Flashcard" },
      "description": "Stores SM-2 spaced repetition flashcards referencing parent /courses/{courseId}."
    },
    "/homeworkSolutions/{solutionId}": {
      "schema": { "$ref": "#/entities/HomeworkSolution" },
      "description": "Stores step-by-step math and homework solutions scoped by userId."
    }
  }
}
