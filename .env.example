# TutorAI Environment Configuration
# Server Port (Default: 3000)
PORT=3000

# Attached Server-Side Gemini API Key (Provided automatically by AI Studio environment)
GEMINI_API_KEY=

# Server Encryption Secret for User API Key Vault (AES-256-GCM at rest)
KEY_VAULT_SECRET=tutorai-local-vault-encryption-secret-v1
